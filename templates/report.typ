// mindtask project report — compiled by `just report-pdf`, which writes the
// inputs beside a copy of this file in the build directory:
//   report.json    — `mindtask report --format json`
//   schedule.json  — `mindtask schedule --format json`
//   <name>.svg     — `mindtask export dot <name> | dot -Tsvg`, one per name in
//                    `--input diagrams=tree,dag` (optional)
// Further inputs: `--input title="…"` (page title), `--input desc=none|short|full`
// (how much of each description to print; default short).

#let title = sys.inputs.at("title", default: "Project report")
#let desc-mode = sys.inputs.at("desc", default: "short")
#let diagrams = sys.inputs.at("diagrams", default: "").split(",").filter(s => s != "")
#let report = json("report.json")
#let sched = json("schedule.json")

#set document(title: title, author: "mindtask")
#set page(paper: "a4", margin: 1.8cm, numbering: "1")
#set text(font: "DejaVu Sans", size: 9pt)
#set par(justify: false)
#show heading.where(level: 1): set text(size: 16pt)
#show heading.where(level: 2): it => { v(0.6em); it }
#show heading.where(level: 3): set text(size: 9.5pt)

// --- helpers -----------------------------------------------------------------

#let muted(body) = text(fill: luma(110), body)
#let tag(id) = text(fill: luma(110), size: 0.85em)[{#id}]

/// A description as `desc-mode` asks for it, or none.
#let describe(obj) = {
  if desc-mode == "none" or "description" not in obj { return none }
  let d = obj.description
  if desc-mode == "short" {
    let cl = d.replace("\n", " ").clusters()
    if cl.len() > 160 { d = cl.slice(0, 159).join() + "…" } else { d = cl.join() }
  }
  text(size: 7.5pt, fill: luma(80), d)
}

/// `2025-04-01 09:00` from an RFC 9557 string, or `–`.
#let due(obj) = if "due" in obj { obj.due.slice(0, 16).replace("T", " ") } else { "–" }

#let ids(list) = if list.len() == 0 { "–" } else { list.map(str).join(", ") }

#let state-cell(state) = {
  let (fill, label) = (
    todo: (none, "todo"),
    in_progress: (rgb("#ffe08a"), "in progress"),
    done: (luma(225), "done"),
  ).at(state)
  table.cell(fill: fill, label)
}

/// Trim trailing zeros off a day count: 2.0 → 2, 1.5 → 1.5.
#let days(x) = {
  let s = str(x)
  if s.contains(".") { s = s.trim("0", at: end).trim(".", at: end) }
  s
}

// --- document ----------------------------------------------------------------

= #title

#muted[
  States shown: #report.states.join(", ").
  #if "timezone" in report [Times in #report.timezone.]
  Generated by mindtask.
]

== Concepts

#let tree-items(nodes) = nodes.map(n => {
  let d = describe(n)
  let line = if d == none [#n.name #tag(n.id)] else [#n.name #tag(n.id) — #d]
  let kids = if n.children.len() > 0 { list(..tree-items(n.children)) } else { none }
  list.item[#line #kids]
})
#if report.concepts.len() == 0 [_No concepts._] else {
  set list(spacing: 0.5em)
  list(..tree-items(report.concepts))
}

== Tasks

#let hidden = report.hidden.todo + report.hidden.in_progress + report.hidden.done

#if report.groups.len() == 0 [_No tasks in the selected states._] else {
  for group in report.groups [
    === #group.title

    #table(
      columns: (auto, 1fr, auto, auto, auto, auto),
      align: (right, left, left, left, left, left),
      stroke: 0.4pt + luma(170),
      inset: 4pt,
      fill: (_, y) => if y == 0 { luma(235) } else { none },
      table.header[*ID*][*Name*][*State*][*Due*][*Depends on*][*Concepts*],
      ..group.tasks.map(t => {
        let d = describe(t)
        let name = if d == none [#t.name] else [#t.name \ #d]
        (str(t.id), name, state-cell(t.state), due(t), ids(t.depends_on), ids(t.concepts))
      }).flatten(),
    )
  ]
}

#if hidden > 0 [
  #muted[(hidden by the state filter: #report.hidden.todo todo, #report.hidden.in_progress in progress, #report.hidden.done done)]
]

#if sched.duration > 0 [
  == Schedule

  #let names = (:)
  #for t in sched.tasks { names.insert(str(t.id), t.name) }

  #table(
    columns: (auto, 1fr, auto, auto, auto, auto),
    align: (right, left, right, right, right, right),
    stroke: 0.4pt + luma(170),
    inset: 4pt,
    fill: (_, y) => if y == 0 { luma(235) } else { none },
    table.header[*ID*][*Name*][*Days*][*Start*][*Finish*][*Slack*],
    ..sched.tasks.map(t => {
      let f = if t.critical { rgb("#ffd6cc") } else { none }
      (
        table.cell(fill: f, str(t.id)),
        table.cell(fill: f, t.name),
        table.cell(fill: f, days(t.duration)),
        table.cell(fill: f, days(t.earliest_start)),
        table.cell(fill: f, days(t.earliest_finish)),
        table.cell(fill: f, days(t.slack)),
      )
    }).flatten(),
  )

  *Project duration:* #days(sched.duration) days
  #if sched.critical_path.len() > 0 [
    \ *Critical path:* #sched.critical_path.map(id => names.at(str(id), default: str(id))).join(" → ")
  ]
]

// One page per diagram, fit to the page: the tree grows downwards (rankdir LR
// stacks the leaves), so it keeps portrait; the DAG runs left to right and
// gets landscape.
#for name in diagrams [
  #set page(flipped: name != "tree", margin: 1.2cm)
  #pagebreak(weak: true)
  == #(tree: "Concept tree", dag: "Task dependency graph").at(name, default: name)
  #align(center + horizon, image(name + ".svg", fit: "contain", width: 100%, height: 90%))
]
